# Copy this file to `.env` and fill in the values from your Appwrite console.
# Appwrite Console -> Project Settings -> gives you the Project ID and API endpoint.
# Appwrite Console -> Databases -> gives you the Database ID and Collection ID.
# Appwrite Console -> Storage -> gives you the Bucket ID.
#
# See flow.md for a full walkthrough of how these are used and what to set up
# in Appwrite (collection attributes, permissions, bucket permissions, etc).

VITE_APPWRITE_URL=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=
VITE_APPWRITE_COLLECTION_ID=
VITE_APPWRITE_BUCKET_ID=

# Optional — powers the live widgets on /about-me (GitHub activity, coding
# hours, last-played track). See functions/dashboard-data/README.md to set
# up the Appwrite Function this points to. Safe to leave unset: those widgets
# just fall back to the placeholder data in src/data/about-me.js until then.
VITE_DASHBOARD_FUNCTION_URL=
